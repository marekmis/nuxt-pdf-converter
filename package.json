{
  "name": "pdf-to-jpg-converter",
  "version": "1.0.0",
  "description": "Convert PDF pages to JPG and combine them vertically with Nuxt 4 UI",
  "author": "Marek",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron": "electron .",
    "desktop": "nuxt build && electron .",
    "dist": "nuxt build && electron-builder --win",
    "dist:dir": "nuxt build && electron-builder --win --dir"
  },
  "dependencies": {
    "@nuxt/ui": "^2.18.7",
    "@types/multer": "^1.4.12",
    "multer": "^1.4.5-lts.1",
    "nuxt": "^3.21.0",
    "pdf-poppler": "^0.2.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@nuxt/devtools": "^1.5.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
